+#ifdef LINUXRUNNER_ANGLE_ZERO_BORDER
+/* Private ANGLE/Metal embedder operation. It does not advertise the full
+ * GLES border-color extension: only an all-zero border is representable. */
+static GLboolean (*linuxrunner_zero_border)(GLuint sampler, GLenum pname);
+void lr_vrend_set_zero_border_sampler(GLboolean (*operation)(GLuint, GLenum));
+void lr_vrend_set_zero_border_sampler(GLboolean (*operation)(GLuint, GLenum))
+{
+   linuxrunner_zero_border = operation;
+}
+#endif
+
+static bool apply_sampler_wrap(struct vrend_context *ctx, GLuint sampler,
+                               GLenum pname, unsigned wrap,
+                               const union pipe_color_union *border)
+{
+#ifdef LINUXRUNNER_ANGLE_ZERO_BORDER
+   if (vrend_state.use_gles && !has_feature(feat_sampler_border_colors) &&
+       wrap == PIPE_TEX_WRAP_CLAMP_TO_BORDER) {
+      if (!border->ui[0] && !border->ui[1] && !border->ui[2] && !border->ui[3] &&
+          linuxrunner_zero_border &&
+          linuxrunner_zero_border(sampler, pname))
+         return true;
+      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_UNSUPPORTED_TEX_WRAP, wrap);
+      return false;
+   }
+#else
+   (void)border;
+#endif
+   glSamplerParameteri(sampler, pname, convert_wrap(ctx, wrap));
+   return true;
+}
